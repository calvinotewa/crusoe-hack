# --- Neon Postgres ---
# Paste the connection string from the Neon console as-is (sslmode params are handled in code).
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Neon Object Storage (S3 compatible) ---
# `neon credentials create --scope storage:read --scope storage:write`, or `neon env pull`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
S3_BUCKET=artifacts

# --- Crusoe Intelligence Foundry (OpenAI-compatible) ---
# Console -> Intelligence Foundry -> API keys. Keys can contain `$`: never double-quote them in a shell.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model IDs are case-sensitive; copy them from GET /playground/models (= /v1/models).
CRUSOE_DEFAULT_MODEL=deepseek-ai/Deepseek-V4-Flash
# Model used to grade outputs (LLM-as-judge)
CRUSOE_JUDGE_MODEL=openai/gpt-oss-120b

# --- Modal (sandboxes) ---
# `modal token new` writes ~/.modal.toml; alternatively set these:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=crusoe-hack-sandboxes
SANDBOX_TIMEOUT_SECONDS=120
