# Run `scripts/setup.sh`: it copies this file to .env and fills in the Neon, Crusoe and Modal
# values for your personal Neon branch. Edit by hand only for overrides.

# --- Neon Postgres (written by `neon env pull`) ---
# Pooled URL for the app; direct URL for Alembic migrations. sslmode params are handled in code.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# --- Neon Object Storage, S3 compatible (written by `neon env pull --service object-storage`) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
S3_BUCKET=artifacts

# --- Crusoe Intelligence Foundry (OpenAI-compatible) ---
# Console -> Intelligence Foundry -> API Keys. Keys can contain `$`: never double-quote them in a shell.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model IDs are case-sensitive; copy them from GET /playground/models (= /v1/models).
CRUSOE_DEFAULT_MODEL=deepseek-ai/Deepseek-V4-Flash
# Model used to grade outputs (LLM-as-judge)
CRUSOE_JUDGE_MODEL=openai/gpt-oss-120b

# --- Modal (sandboxes) ---
# `uv run modal token new` writes ~/.modal.toml (the setup script does this). For CI, set these instead:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=crusoe-hack-sandboxes
SANDBOX_TIMEOUT_SECONDS=120

# --- Crusoe model roles (Shared Brain) ---
# Researcher agents (propose experiments); Curator (summarizes, hypothesizes)
CRUSOE_RESEARCHER_MODEL=nvidia/Nemotron-3-Super-120B-A12B
CRUSOE_CURATOR_MODEL=nvidia/Nemotron-3-Ultra-550B

# --- Orchestration harness ---
# Researchers per generation (the spec targets 100; Crusoe free tier is 30 RPM).
HARNESS_NUM_AGENTS=6
# Experiments whose thinking gets summarized per generation (spec: top 10).
HARNESS_TOP_K=10
# Hypotheses the curator generates per generation (spec: 100).
HARNESS_NUM_HYPOTHESES=10
# Fraction of a generation that gets to write the knowledge prompt.
HARNESS_TOP_FRACTION=0.1
# Generations per POST /sessions run; more via POST /sessions/{id}/iterate.
HARNESS_MAX_GENERATIONS=3

# --- you.com (web search for the research step) ---
# Console -> API keys. Free tier exists; leave empty to skip the research step.
YOU_API_KEY=
YOU_API_BASE=https://api.ydc-api.io
RESEARCH_NUM_SOURCES=20
