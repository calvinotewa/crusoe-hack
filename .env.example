# crusoe-hack environment sample
# Copy to `.env` (gitignored) and fill in real values: `cp .env.sample .env`
# Never commit `.env` or `.env.local`. Settings live in app/config.py; every variable
# here maps 1:1 to a Settings field (pydantic-settings reads .env then .env.local).

# --- Neon Postgres ---
# From the Neon console as-is; sslmode params are handled in code.
# Pooled URL for the app; direct (non-pooler) URL for Alembic migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Neon Object Storage (S3 compatible) ---
# `neon credentials create --scope storage:read --scope storage:write`, or `neon env pull`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
S3_BUCKET=artifacts

# --- Crusoe Intelligence Foundry (OpenAI-compatible inference) ---
# Console -> Intelligence Foundry -> Inference -> Create API Key (NOT a Cloud API Key).
# Keys are shown once, are project-scoped, and may contain `$`: single-quote in shells.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model IDs are case-sensitive; verify against GET /v1/models before changing.
CRUSOE_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Model used to grade outputs (LLM-as-judge)
CRUSOE_JUDGE_MODEL=openai/gpt-oss-120b
# Shared Brain roles: researchers propose experiments, the curator summarizes + hypothesizes
CRUSOE_RESEARCHER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
CRUSOE_CURATOR_MODEL=deepseek-ai/DeepSeek-V4-Pro

# --- Modal (sandboxes for the API path) ---
# `modal token new` writes ~/.modal.toml; alternatively set these:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=crusoe-hack-sandboxes
SANDBOX_TIMEOUT_SECONDS=120

# --- Orchestration harness (Shared Brain) ---
# Researchers per generation (spec targets 100; mind Crusoe's 30 RPM free tier)
HARNESS_NUM_AGENTS=6
# Experiments whose thinking gets summarized per generation (spec: top 10)
HARNESS_TOP_K=10
# Hypotheses per generation: FIXED count, identical in every generation (default 20)
HARNESS_NUM_HYPOTHESES=20
# Fraction of a generation that earns a slot in the inherited-learnings prompt
HARNESS_TOP_FRACTION=0.1
# Generations per run; more via POST /sessions/{id}/iterate or the dashboard form
HARNESS_MAX_GENERATIONS=3

# --- you.com Web Search API (research step between generations) ---
# https://you.com/platform -> API keys. Current endpoint: POST {YOU_API_BASE}/v1/search.
# Leave empty to fall back to keyless DuckDuckGo search.
YOU_API_KEY=
YOU_API_BASE=https://ydc-index.io
# Sources fetched per research step (spec: 20)
RESEARCH_NUM_SOURCES=20